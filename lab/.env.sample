# Copy to .env.  ->  cp lab/.env.sample lab/.env
#
# NOTHING below needs filling in: every value is already correct for the course environment,
# and model calls are KEYLESS - they reuse the sign-in from Module 3's first step
# (python m3_login.py), the same session that reads the claims book.

# --------------------------------------------------------------- Azure AI Foundry (Modules 2, 3)
FOUNDRY_ENDPOINT=https://emberwatch-oracle-eus2.cognitiveservices.azure.com/
# KEYLESS BY DEFAULT: leave this line exactly as it is. Paste a real value ONLY to override
# the sign-in - your own resource's key if you run this lab in your own tenant, or a token you
# minted yourself:
#   az account get-access-token --resource https://cognitiveservices.azure.com --query accessToken -o tsv
# Whatever is here is sent as "Authorization: Bearer <value>", which is why a key and a token
# are interchangeable. A pasted token expires after ~86 minutes; a key does not.
FOUNDRY_KEY=<leave-as-is-for-keyless-or-paste-your-own>
MODEL_DEPLOYMENT=gpt-5-mini
# Agent Framework base_url (note the /openai/v1/ suffix — required for gpt-5):
FOUNDRY_OPENAI_V1=https://emberwatch-oracle-eus2.cognitiveservices.azure.com/openai/v1/

# --------------------------------------------------------------- Dataverse (Module 3)
# WHICH TENANT YOU SIGN IN TO, AND WHICH ENVIRONMENT YOU READ.
#
# Neither is a secret. A tenant id and an org URL identify a directory and a database; they grant
# nothing on their own, and you still have to sign in as yourself and hold a role. They are here
# rather than in the source so that running this lab against a DIFFERENT environment is a config
# change instead of a code edit.
#
# Leave both as they are for the course. Change them only if you are pointing the lab at your own
# tenant, in which case you also need the Module 3 tables and the role grant - they are in the
# setup pack your instructor sends on request, not in this repository.
DATAVERSE_TENANT=30d4eca5-0b84-4868-89d5-b0fc78c105c4
DATAVERSE_ORG=https://org3425656b.crm4.dynamics.com
